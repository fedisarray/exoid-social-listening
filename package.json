{
  "name": "exoid-reviews",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start -x studio,edge-runtime,logflare,vector,supavisor,realtime,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-types.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-analysts.mjs",
    "format": "prettier --write app features lib components scripts *.ts *.mjs *.json",
    "format:check": "prettier --check app features lib components scripts *.ts *.mjs *.json",
    "worker": "node scripts/collection-worker.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.1",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "shadcn": "4.23.0",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
